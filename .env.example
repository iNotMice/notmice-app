# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# --- Phase 2 backend (FastAPI / PostgreSQL) ---
# Used by docker compose. Do not put production secrets in this file.
POSTGRES_USER=notmice
POSTGRES_PASSWORD=notmice
POSTGRES_DB=notmice
DATABASE_URL=postgresql+asyncpg://notmice:notmice@localhost:5432/notmice
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
LOG_LEVEL=INFO
# development locally. On the host set production so insecure secrets refuse to boot.
APP_ENV=development
# Argon2 pepper and JWT signing key. Required, must differ. Never reuse one value for both.
SEED_HASH_SECRET=dev-insecure-seed-hash-change-me-not-for-prod
JWT_SECRET=dev-insecure-jwt-signing-change-me-not-for-prod

# Vision LLM for scan/photo extraction (module 3). Gemini is the starter; Claude is a later swap.
VISION_PROVIDER=gemini
GEMINI_MODEL=gemini-3.8-flash
# Paid Gemini key only — free-tier requests may be used to train Google models.
# GEMINI_API_KEY=

# In-memory UTC-day caps for Gemini extract. One API process; a restart clears them.
GEMINI_DAILY_TOKEN_BUDGET=2000000
GEMINI_USER_DAILY_TOKEN_BUDGET=100000
GEMINI_IP_DAILY_TOKEN_BUDGET=150000
GEMINI_CALL_TOKEN_RESERVE=16000
GEMINI_USER_DAILY_CALLS=8
GEMINI_IP_DAILY_CALLS=12
GEMINI_BUDGET_WARN_RATIO=0.8
GEMINI_TIMEOUT_SECONDS=60

# Phrase login for accounts that already have a recovery phrase. New accounts use email.
AUTH_SEED_ENABLED=true
# Links in confirmation and reset mail.
PUBLIC_APP_URL=http://localhost:8080
# Leave SMTP_HOST empty in development: the API logs the link. Set it before real users.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=
# Account routes: 20 per IP and 5 per account, each over 15 minutes.
ACCOUNT_RATE_LIMIT=20
ACCOUNT_RATE_LIMIT_WINDOW_SECONDS=900
ACCOUNT_IDENTITY_RATE_LIMIT=5
ACCOUNT_IDENTITY_RATE_LIMIT_WINDOW_SECONDS=900

# Reserved for a later Claude Vision swap. Leave empty while VISION_PROVIDER=gemini.
# CLAUDE_API_KEY=
# CLAUDE_MODEL=claude-sonnet-5

# Public dataset reads (module 6). 60 requests per IP per minute.
DATASET_RATE_LIMIT=60
DATASET_RATE_LIMIT_WINDOW_SECONDS=60
# Honor X-Real-IP from the nginx proxy. X-Forwarded-For is never used.
TRUST_PROXY_HEADERS=true

# Basic auth for /docs and /openapi.json on the nginx proxy. Not a production password.
DOCS_BASIC_AUTH_USER=docs
DOCS_BASIC_AUTH_PASSWORD=dev-docs-change-me

# --- Production (docker-compose.prod.yml on the VPS) ---
# Put these in the host environment. Do not commit real values.
# APP_ENV is fixed to production by that compose file.
# VITE_API_BASE_URL stays empty: the site and the API share one origin.
# POSTGRES_PASSWORD=<required>
# SEED_HASH_SECRET=<required, different from JWT_SECRET, 32+ characters, no dev-insecure prefix>
# JWT_SECRET=<required, different from SEED_HASH_SECRET, 32+ characters, no dev-insecure prefix>
# GEMINI_API_KEY=<paid key>
# CORS_ORIGINS=https://your-vps-domain
# DOCS_BASIC_AUTH_USER=<required>
# DOCS_BASIC_AUTH_PASSWORD=<required, not dev-docs-change-me>
